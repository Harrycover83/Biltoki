generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
}

enum NotificationType {
  EVENT
  NEW_PRODUCER
  FLASH_OFFER
  HALL_NEWS
}

model User {
  id                  String                 @id @default(uuid())
  email               String                 @unique
  passwordHash        String
  name                String
  phone               String?
  preferredHallId     String?
  loyaltyPoints       Int                    @default(0)
  loyaltyTier         LoyaltyTier            @default(BRONZE)
  qrCodeValue         String                 @unique
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  preferredHall       Hall?                  @relation("PreferredHall", fields: [preferredHallId], references: [id])
  dietaryPreferences  UserDietaryPreference[]
  hallSubscriptions   HallSubscription[]
  eventInterests      EventInterest[]
  loyaltyTransactions LoyaltyTransaction[]
  pushTokens          PushToken[]
}

model DietaryPreference {
  id    String                 @id @default(uuid())
  code  String                 @unique
  label String
  users UserDietaryPreference[]
}

model UserDietaryPreference {
  userId               String
  dietaryPreferenceId  String
  dietaryPreference    DietaryPreference @relation(fields: [dietaryPreferenceId], references: [id])
  user                 User              @relation(fields: [userId], references: [id])

  @@id([userId, dietaryPreferenceId])
}

model Hall {
  id             String             @id @default(uuid())
  name           String
  city           String
  address        String
  openingHours   String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  subscribers    HallSubscription[]
  events         Event[]
  notifications  Notification[]
  photos         HallPhoto[]
  preferredBy    User[]             @relation("PreferredHall")
  producers      HallProducer[]
}

model HallPhoto {
  id       String @id @default(uuid())
  hallId   String
  imageUrl String
  hall     Hall   @relation(fields: [hallId], references: [id])
}

model Producer {
  id        String         @id @default(uuid())
  name      String
  category  String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  halls     HallProducer[]
}

model HallProducer {
  hallId     String
  producerId String
  hall       Hall     @relation(fields: [hallId], references: [id])
  producer   Producer @relation(fields: [producerId], references: [id])

  @@id([hallId, producerId])
}

model Event {
  id            String          @id @default(uuid())
  hallId         String
  title          String
  description    String
  startsAt       DateTime
  location       String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  hall           Hall            @relation(fields: [hallId], references: [id])
  interestedBy   EventInterest[]
}

model EventInterest {
  eventId    String
  userId     String
  remindAt   DateTime?
  createdAt  DateTime @default(now())
  event      Event    @relation(fields: [eventId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@id([eventId, userId])
}

model HallSubscription {
  hallId       String
  userId       String
  subscribedAt DateTime @default(now())
  hall         Hall     @relation(fields: [hallId], references: [id])
  user         User     @relation(fields: [userId], references: [id])

  @@id([hallId, userId])
}

model LoyaltyTransaction {
  id        String   @id @default(uuid())
  userId    String
  hallId    String?
  points    Int
  reason    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model PushToken {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  platform   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id])
}

model Notification {
  id        String           @id @default(uuid())
  hallId    String?
  title     String
  body      String
  type      NotificationType
  isGlobal  Boolean          @default(false)
  createdAt DateTime         @default(now())
  hall      Hall?            @relation(fields: [hallId], references: [id])
}
